JEVENT_USERNAME=
JEVENT_PASSWORD=
JEVENT_EVENT_ID=100924

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=

# Prod Docker (docker compose -f docker-compose.prod.yml); образ собирается локально
# BOT_IMAGE=holy-notification-bot:latest
# BOT_IMAGE=ghcr.io/YOUR_USER/holy-notification-bot:latest

# Планировщик: вс 16:00, вт 13:00, чт 16:00 (Europe/Moscow)
REMINDER_TIMEZONE=Europe/Moscow
REMINDER_SLOTS=Sun:16:00,Tue:13:00,Thu:16:00

# Застой: DM только по заявкам в «Ревью ПК» >= N дней (lastStatusUpdate). 0 = без фильтра
STALL_THRESHOLD_DAYS=14
