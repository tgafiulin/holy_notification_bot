{
  "name": "holy_notification_bot",
  "version": "1.0.0",
  "description": "Telegram bot reminders for jEvent conference talk voting",
  "type": "module",
  "scripts": {
    "login": "tsx src/cli/login-test.ts",
    "login:headed": "tsx src/cli/login-test.ts --headed",
    "poll": "tsx src/cli/poll-test.ts",
    "bot": "tsx src/cli/bot.ts",
    "bot:dev": "tsx watch src/cli/bot.ts",
    "docker:build": "bash scripts/docker-build-prod.sh",
    "docker:push": "bash scripts/docker-push-prod.sh",
    "docker:save": "bash scripts/docker-save-prod.sh"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.39.3",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
